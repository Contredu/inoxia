// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

//-------------------------------------------------------------------------------------------------------------------------
// Provider de la Base de datos. generado automaticamente
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//-------------------------------------------------------------------------------------------------------------------------
//ENUM

enum Role {
  USER
  ADMIN
}

enum Category {
  PULSERAS
  COLLARES
  PENDIENTES
  ANILLOS
  TOBILLERAS
  CONJUNTOS
  OTROS
}

enum Method {
  CRYPTOCURRENCY
  CREDIT_CARD
  PAYPAL
}

enum Status {
  PENDING
  IN_PROGRESS
  APROVAL
  FINISH
}

enum Color {
  GOLD
  SILVER
}

enum Material {
  STEEL
  SILVER
  GOLD
  OTRO
  MIX
}

//-------------------------------------------------------------------------------------------------------------------------
//TABLAS

//Guarda Todos los usuarios clientes y administradores
model User {
  id            Int     @id @default(autoincrement())
  email         String  @unique
  name          String
  lastname      String?
  passwordHash  String
  profile_image String?
  phone         String?
  role          Role    @default(USER)
  address       String?
  creditcard          Int?
  favorites Wishlist[]
  orders Orders[]
}

//Guarda Todos los productos de la tienda
model Product {
  id          Int        @id @default(autoincrement())
  name        String
  description String
  stock       Int
  price       Float
  sku         String?
  review      String?
  color Color
  material Material
  category    Category   @default(OTROS)
  productId   Int
  element     Categories @relation(fields: [productId], references: [id])
}

//Guarda Collares, Pendientes ... 
model Categories {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  image       String?
  slug        String
  position    String
  products    Product[]
}

//Guarda imagenes de cada producto
model Product_image {
  productId Int    @id
  position  String
  publicId  String
}

//Guarda pedidos realizados
model Orders {
  id            Int    @id @default(autoincrement())
  orderNumber   Int
  status        Status @default(PENDING)
  total         Float
  paymentMethod Method @default(CREDIT_CARD)
}

//Guarda Lineas de cada pedido
model Order_items {
  orderId   Int   @id @default(autoincrement())
  productId Int
  price     Float
  quantity  Int
}

//Guarda Lista de deseo de cada Usuario
model Wishlist {
  userId       Int  @id @default(autoincrement())
  productId    Int
  element-wish User @relation(fields: [Wish-list], references: [productId])
}

//Guarda Carrito de cada usuario (persistente)
model Cart_items {
  userId    Int @id @default(autoincrement())
  productId Int
  quantity  Int
  size      Int
}

//Guarda Direcciones de envio guardadas
model Address {
  userId     Int     @id @default(autoincrement())
  line1      String
  line2      String?
  city       String
  postalCode Int
}

//Guarda reseñas de productos
model Reviews {
  userId    Int    @id @default(autoincrement())
  productId Int
  rating    Int
  comment   String
}

//Guarda cupones de descuento
model Coupons {
  id        Int      @id
  code      String   @unique
  type      String
  value     Float
  maxUses   Int
  expiresAt DateTime
}
