// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

//-------------------------------------------------------------------------------------------------------------------------
// Es el archivo central de configuración
// Provider de la Base de datos. generado automaticamente

// EL generator client indica que prisma generará el código del cliente.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Datasource define la conexión
datasource db {
  provider = "postgresql"
}

//-------------------------------------------------------------------------------------------------------------------------
//ENUM

enum Role {
  USER
  ADMIN
}

enum Category {
  PULSERAS
  COLLARES
  PENDIENTES
  ANILLOS
  TOBILLERAS
  CONJUNTOS
  OTROS
}

enum Method {
  CRYPTOCURRENCY
  CREDIT_CARD
  PAYPAL
}

enum Status {
  PENDING
  IN_PROGRESS
  APROVAL
  FINISH
}

enum Color {
  GOLD
  SILVER
}

enum Material {
  STEEL
  SILVER
  GOLD
  OTRO
  MIX
}

enum Size {
  XS
  S
  M
  L
  XL
  XXL
}

//-------------------------------------------------------------------------------------------------------------------------
// Modelos define una entidad (tabla) con campos y atributos especiales.

// TABLAS

// Guarda Todos los usuarios clientes y administradores
model User {
  id            Int          @id @default(autoincrement())
  email         String       @unique
  name          String
  lastname      String?
  passwordHash  String
  profile_image String?
  phone         String?
  role          Role         @default(USER)
  creditcard    Int?
  favorites     Wishlist[]
  orders        Orders[]
  coupons       Coupons[]
  cart_list     Cart_items[]
  address       Address[]
  review        Reviews[]
}

//Guarda Todos los productos de la tienda
model Product {
  id          Int             @id @default(autoincrement())
  name        String
  description String
  stock       Int
  price       Float
  sku         String?
  color       Color
  material    Material
  category    Category        @default(OTROS)
  review      Reviews[]
  wish        Wishlist[]
  image       Product_image[]
  order       Order_items[]
  cart        Cart_items[]

  categories   Categories? @relation(fields: [categoriesId], references: [id])
  categoriesId Int?
}

//Guarda Collares, Pendientes ... 
model Categories {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  image       String?
  slug        String
  position    String
  products    Product[]
}

//Guarda imagenes de cada producto
model Product_image {
  productId Int     @id
  position  String
  publicId  String
  product   Product @relation(fields: [productId], references: [id])
}

//Guarda pedidos realizados
model Orders {
  id            Int    @id @default(autoincrement())
  orderNumber   Int
  status        Status @default(PENDING)
  total         Float
  paymentMethod Method @default(CREDIT_CARD)
  user          User   @relation(fields: [userId], references: [id])
  userId        Int
}

//Guarda Lineas de cada pedido
model Order_items {
  orderId   Int     @id @default(autoincrement())
  productId Int
  price     Float
  quantity  Int
  product   Product @relation(fields: [productId], references: [id])
}

//Guarda Lista de deseo de cada Usuario
model Wishlist {
  id        Int     @id @default(autoincrement())
  userId    Int
  productId Int
  user      User    @relation(fields: [userId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

//Guarda Carrito de cada usuario (persistente)
model Cart_items {
  userId    Int     @id @default(autoincrement())
  productId Int
  quantity  Int
  size      Size    @default(S)
  user      User    @relation(fields: [userId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

//Guarda Direcciones de envio guardadas
model Address {
  userId     Int     @id @default(autoincrement())
  line1      String
  line2      String?
  city       String
  postalCode Int
  user       User    @relation(fields: [userId], references: [id])
}

//Guarda reseñas de productos
model Reviews {
  userId    Int     @id @default(autoincrement())
  productId Int
  rating    Int
  comment   String
  user      User    @relation(fields: [userId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

//Guarda cupones de descuento
model Coupons {
  id        Int      @id
  code      String   @unique
  type      String
  value     Float
  maxUses   Int
  expiresAt DateTime
  user      User?    @relation(fields: [userId], references: [id])
  userId    Int?
}
